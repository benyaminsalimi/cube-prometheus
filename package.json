{
  "name": "cube-prometheus",
  "version": "1.8.28",
  "description": "Prometheus metrics and structured logs for a self-hosted Cube (OSS) deployment, using Cube's public logger hook",
  "license": "Apache-2.0",
  "author": "cube_observability",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src",
    "tools",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cube",
    "cubejs",
    "prometheus",
    "metrics",
    "observability"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "contract": "node tools/contract-check.mjs"
  },
  "dependencies": {
    "prom-client": "15.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benyaminsalimi/cube-prometheus.git"
  },
  "homepage": "https://github.com/benyaminsalimi/cube-prometheus#readme",
  "bugs": {
    "url": "https://github.com/benyaminsalimi/cube-prometheus/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./catalog": "./src/catalog.js",
    "./contract": "./src/contract.js",
    "./package.json": "./package.json"
  }
}
